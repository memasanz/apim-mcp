{
  "$schema": "./config.schema.json",
  "version": 1,
  "defaults": {
    "timeoutSeconds": 60,
    "subscriptionId": null
  },
  "services": {
    "apim": {
      "displayName": "API Management",
      "description": "Azure API Management control-plane operations via `az apim`.",
      "resources": {
        "service": {
          "displayName": "APIM Service",
          "commands": {
            "list": { "enabled": true,  "mutation": false, "azCommand": ["apim", "list"] },
            "show": { "enabled": true,  "mutation": false, "azCommand": ["apim", "show"] }
          }
        },
        "api": {
          "displayName": "APIs",
          "commands": {
            "list":   { "enabled": true,  "mutation": false, "azCommand": ["apim", "api", "list"] },
            "show":   { "enabled": true,  "mutation": false, "azCommand": ["apim", "api", "show"] },
            "create": { "enabled": false, "mutation": true,  "azCommand": ["apim", "api", "create"] },
            "update": { "enabled": false, "mutation": true,  "azCommand": ["apim", "api", "update"] },
            "delete": { "enabled": false, "mutation": true,  "azCommand": ["apim", "api", "delete"] }
          }
        },
        "product": {
          "displayName": "Products",
          "commands": {
            "list": { "enabled": true, "mutation": false, "azCommand": ["apim", "product", "list"] },
            "show": { "enabled": true, "mutation": false, "azCommand": ["apim", "product", "show"] }
          }
        },
        "api-operation": {
          "displayName": "API Operations",
          "commands": {
            "list": { "enabled": true, "mutation": false, "azCommand": ["apim", "api", "operation", "list"] },
            "show": { "enabled": true, "mutation": false, "azCommand": ["apim", "api", "operation", "show"] }
          }
        },
        "api-revision": {
          "displayName": "API Revisions",
          "commands": {
            "list": { "enabled": true, "mutation": false, "azCommand": ["apim", "api", "revision", "list"] }
          }
        },
        "named-value": {
          "displayName": "Named Values",
          "commands": {
            "list": { "enabled": true, "mutation": false, "azCommand": ["apim", "nv", "list"] },
            "show": { "enabled": true, "mutation": false, "azCommand": ["apim", "nv", "show"] }
          }
        },
        "backend": {
          "displayName": "Backends",
          "commands": {
            "list": { "enabled": true, "mutation": false, "azCommand": ["apim", "backend", "list"] },
            "show": { "enabled": true, "mutation": false, "azCommand": ["apim", "backend", "show"] }
          }
        },
        "api-versionset": {
          "displayName": "API Version Sets",
          "commands": {
            "list": { "enabled": true, "mutation": false, "azCommand": ["apim", "api", "versionset", "list"] },
            "show": { "enabled": true, "mutation": false, "azCommand": ["apim", "api", "versionset", "show"] }
          }
        },
        "api-release": {
          "displayName": "API Releases",
          "commands": {
            "list": { "enabled": true, "mutation": false, "azCommand": ["apim", "api", "release", "list"] }
          }
        }
      }
    }
  }
}
