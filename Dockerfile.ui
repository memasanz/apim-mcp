# syntax=docker/dockerfile:1.7
# UI image — React SPA + thin admin REST API. No azure-cli.

FROM node:20-alpine AS ui-build
WORKDIR /ui
COPY ui/package.json ui/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY ui/ ./
RUN npm run build

FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOST=0.0.0.0 \
    PORT=8000 \
    CONFIG_PATH=/etc/cli-mcp/config.json \
    LOG_LEVEL=INFO

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY server/pyproject.toml ./server/pyproject.toml
RUN pip install --upgrade pip \
 && pip install \
      "fastapi>=0.115" \
      "uvicorn[standard]>=0.30" \
      "pydantic>=2.7" \
      "pydantic-settings>=2.4" \
      "azure-identity>=1.17" \
      "azure-storage-blob>=12.20" \
      "httpx>=0.27" \
      "python-jose[cryptography]>=3.3" \
      "watchfiles>=0.22" \
      "mcp>=1.2.0"

COPY server/ ./server/
RUN pip install --no-deps -e ./server

COPY --from=ui-build /server/app/static ./server/app/static

RUN mkdir -p /etc/cli-mcp
COPY config/config.sample.json /etc/cli-mcp/config.json

EXPOSE 8000
WORKDIR /app/server

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost:${PORT}/healthz || exit 1

CMD ["python", "-m", "app.main_ui"]
