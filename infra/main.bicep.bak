// Provisions: Log Analytics, Container Apps Environment, Container App with
// system-assigned managed identity, baseline Reader RBAC at the subscription
// scope, and a Key Vault that holds the optional MCP API key.

targetScope = 'resourceGroup'

@description('Short app name (lowercase, 2-12 chars).')
@minLength(2)
@maxLength(12)
param appName string = 'climcp'

@description('Azure region for all resources.')
param location string = resourceGroup().location

@description('Container image, e.g. myacr.azurecr.io/cli-mcp:0.1.0')
param image string

@description('Name of the Azure Container Registry that hosts the image (in the same resource group).')
param acrName string

@description('Entra tenant ID used to validate JWTs.')
param tenantId string = subscription().tenantId

@description('Audience expected in inbound JWTs (the app registration client id or api://... URI).')
param entraAudience string

@description('Optional API key value to store in Key Vault and inject into the app.')
@secure()
param apiKey string = ''

@description('Optional subscription id the app should default to. Empty = use the app identity default.')
param defaultSubscriptionId string = ''

@description('Tags applied to all resources.')
param tags object = {
  app: 'cli-mcp-tool'
}

var resourcePrefix = toLower(appName)
var uniq = uniqueString(resourceGroup().id, appName)

// ---------- Log Analytics ----------
resource law 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: '${resourcePrefix}-law-${uniq}'
  location: location
  tags: tags
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
  }
}

// ---------- Key Vault (only when apiKey supplied) ----------
resource kv 'Microsoft.KeyVault/vaults@2023-07-01' = if (!empty(apiKey)) {
  name: '${resourcePrefix}-kv-${uniq}'
  location: location
  tags: tags
  properties: {
    tenantId: tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
    publicNetworkAccess: 'Enabled'
  }
}

resource kvSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = if (!empty(apiKey)) {
  parent: kv
  name: 'mcp-api-key'
  properties: { value: apiKey }
}

// ---------- Container Apps Environment ----------
resource cae 'Microsoft.App/managedEnvironments@2024-03-01' = {
  name: '${resourcePrefix}-env-${uniq}'
  location: location
  tags: tags
  properties: {
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: {
        customerId: law.properties.customerId
        sharedKey: law.listKeys().primarySharedKey
      }
    }
  }
}

// ---------- User-assigned managed identity ----------
// We use a UAMI (not system-assigned) so AcrPull on the registry can be
// granted *before* the Container App ever tries to pull the image.
resource uami 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: '${resourcePrefix}-id-${uniq}'
  location: location
  tags: tags
}

// ---------- ACR reference + AcrPull for the UAMI ----------
resource acr 'Microsoft.ContainerRegistry/registries@2023-07-01' existing = {
  name: acrName
}

var acrPullRoleId = '7f951dda-4ed3-4680-a7ca-43fe172d538d'
resource acrPullAssignment 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(acr.id, uami.id, 'acrpull')
  scope: acr
  properties: {
    principalId: uami.properties.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId(
      'Microsoft.Authorization/roleDefinitions',
      acrPullRoleId
    )
  }
}

// ---------- Container App ----------
resource app 'Microsoft.App/containerApps@2024-03-01' = {
  name: '${resourcePrefix}-app-${uniq}'
  location: location
  tags: tags
  dependsOn: [ acrPullAssignment ]
  identity: {
    type: 'SystemAssigned, UserAssigned'
    userAssignedIdentities: {
      '${uami.id}': {}
    }
  }
  properties: {
    managedEnvironmentId: cae.id
    configuration: {
      ingress: {
        external: true
        targetPort: 8000
        transport: 'auto'
        allowInsecure: false
      }
      registries: [
        {
          server: acr.properties.loginServer
          identity: uami.id
        }
      ]
      secrets: empty(apiKey) ? [] : [
        {
          name: 'mcp-api-key'
          value: apiKey
        }
      ]
    }
    template: {
      containers: [
        {
          name: 'cli-mcp'
          image: image
          resources: {
            cpu: json('0.5')
            memory: '1Gi'
          }
          env: union(
            [
              { name: 'ENTRA_TENANT_ID', value: tenantId }
              { name: 'ENTRA_AUDIENCE',  value: entraAudience }
              { name: 'AZURE_SUBSCRIPTION_ID', value: defaultSubscriptionId }
              { name: 'CONFIG_PATH', value: '/etc/cli-mcp/config.json' }
            ],
            empty(apiKey) ? [] : [ { name: 'MCP_API_KEY', secretRef: 'mcp-api-key' } ]
          )
        }
      ]
      scale: {
        minReplicas: 1
        maxReplicas: 3
      }
    }
  }
}

// ---------- Baseline RBAC: Reader at resource group scope ----------
// Built-in 'Reader' role definition id.
var readerRoleId = 'acdd72a7-3385-48ef-bd42-f606fba81ae7'
resource readerAssignment 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(resourceGroup().id, app.id, 'reader')
  scope: resourceGroup()
  properties: {
    principalId: app.identity.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId(
      'Microsoft.Authorization/roleDefinitions',
      readerRoleId
    )
  }
}

// ---------- Key Vault Secrets User (for the app's MI) ----------
var kvSecretsUserRoleId = '4633458b-17de-408a-b874-0445c86b69e6'
resource kvRole 'Microsoft.Authorization/roleAssignments@2022-04-01' = if (!empty(apiKey)) {
  name: guid(resourceGroup().id, app.id, 'kv-secrets-user')
  scope: kv
  properties: {
    principalId: app.identity.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId(
      'Microsoft.Authorization/roleDefinitions',
      kvSecretsUserRoleId
    )
  }
}

output appUrl string = 'https://${app.properties.configuration.ingress.fqdn}'
output principalId string = app.identity.principalId
